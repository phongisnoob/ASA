  "inventory_version": "1.0.0",
  "description": "Canonical English phone inventory for ASA M2/M3/M4 (CMUdict ARPABET, 39 base phones). Stress is stored separately from phone identity.",
  "canonical_representation": "ARPABET",
  "display_representation": "IPA (General American; display only)",
  "id_policy": {
    "assignment": "alphabetical over ARPABET base phones, frozen at 1.0.0",
    "evolution": "append-only: new phones receive new IDs; existing IDs never change",
    "reserved_ids": {
      "0": "CTC blank by convention (not a phoneme, not silence)"
    }
  },
  "stress": {
    "values": [
      0,
      1,
      2
    ],
    "labels": {
      "0": "unstressed",
      "1": "primary",
      "2": "secondary"
    },
    "applies_to": "vowel",
    "separate_from_phone_identity": true,
    "symbol_pattern": "^([A-Z]+)([012])?$",
    "note": "ARPABET stress digits are parsed off the symbol (AY1 -> AY + 1). Phone IDs identify the base phone only."
  },
  "special_symbols": [
    {
      "symbol": "<blank>",
      "id": 0,
      "role": "ctc_blank",
      "is_phoneme": false,
      "is_silence": false,
      "description": "CTC blank index by convention. Not a phoneme and not automatically silence. M3 may relocate it in its output layer; if so it must document the offset."
    }
  ],
  "silence_policy": {
    "has_silence_class": false,
    "note": "No silence class is defined because the downstream acoustic model's support is unknown. Aligner silence labels (sil, sp, <eps>, empty) are kept as label roles in alignment output, never as inventory phones."
  },
