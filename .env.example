# Environment variables actually read by asa-m2 (all optional).
# Copy to .env and export them in your shell; asa-m2 does NOT load .env files itself.

# Default YAML config used when --config is not passed.
ASA_M2_CONFIG=configs/default.yaml

# Default log level (DEBUG, INFO, WARNING, ERROR). Overridden by --log-level.
ASA_M2_LOG_LEVEL=INFO

# Optional: opt in to the live Qwen3-ForcedAligner integration test
# (requires `pip install qwen-asr` and a model download; see README).
# ASA_M2_RUN_QWEN=1

# Optional: opt in to the live MFA integration test. Both models must already be
# installed in the local MFA model store (see `mfa model download ...`).
# ASA_M2_MFA_ACOUSTIC_MODEL=english_us_arpa

# MFA's own root directory variable (verified in MFA 3.4.3 source). If set it is
# passed through to MFA subprocesses unchanged.
# MFA_ROOT_DIR=/path/to/mfa_root
